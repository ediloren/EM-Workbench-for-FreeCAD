<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>ElectroMagnetic Workbench</name>
  <description>This project is dedicated to building an ElectroMagnetic workbench for FreeCAD, with support for inductance and capacitance solvers.</description>
  <version>3.0.0</version>
  <date>2026-10-17</date>
  <freecadmin>1.0.0</freecadmin>
  <maintainer email="enrico dot di_lorenzo at fastfieldsolvers dot com">Enrico Di Lorenzo</maintainer>
  <license file="LICENCE.txt">LGPL-2.1-or-later</license>
  <url type="repository" branch="master">https://github.com/ediloren/EM-Workbench-for-FreeCAD</url>
  <url type="website">https://github.com/ediloren/EM-Workbench-for-FreeCAD</url>
  <url type="bugtracker">https://github.com/ediloren/EM-Workbench-for-FreeCAD/issues</url>
  <url type="readme">https://raw.githubusercontent.com/ediloren/EM-Workbench-for-FreeCAD/master/README.md</url>
  <url type="documentation">https://github.com/ediloren/EM-Workbench-for-FreeCAD/tree/master/Documentation</url>
  <pythonmin>3.10</pythonmin>
  <depend type="internal">draft</depend>
  <depend type="internal">part</depend>
  <depend type="internal">mesh</depend>
  <depend type="python">numpy</depend>
  <depend type="python">scipy</depend>
  <icon>Resources/Icons/EMWorkbench.svg</icon>

  <content>
    <workbench>
      <classname>EMWorkbench</classname>
      <subdirectory>freecad/EM</subdirectory>
    </workbench>
  </content>

</package>

